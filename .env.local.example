# Salin file ini jadi .env.local lalu isi dari dashboard Supabase
# (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-di-sini

# Service role key — dipakai route API server-side buat nerima pesanan
# dan upload bukti. TANPA prefix NEXT_PUBLIC_ supaya tidak bocor ke browser.
# JANGAN pernah di-commit atau ditempel di chat/screenshot.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini

# Login admin sekarang pakai Supabase Auth (Authentication -> Users),
# bukan lagi password di environment variable.

# Midtrans — pembayaran QRIS otomatis. Kosong/placeholder = pakai QRIS statis + upload bukti.
# Server Key: Dashboard Midtrans -> Settings -> Access Keys. RAHASIA, tanpa NEXT_PUBLIC_.
MIDTRANS_SERVER_KEY=isi-server-key-midtrans
# false = sandbox (testing), true = production (uang beneran)
MIDTRANS_IS_PRODUCTION=false
# URL publik webhook. Diisi setelah deploy, mis. https://po-kripik.vercel.app/api/midtrans/notifikasi
# Dikirim per transaksi lewat header X-Override-Notification, jadi aman walau akun
# Midtrans-nya dipakai bareng project lain.
MIDTRANS_NOTIFICATION_URL=
